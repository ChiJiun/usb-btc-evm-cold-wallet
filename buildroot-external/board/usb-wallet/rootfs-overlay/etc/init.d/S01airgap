#!/bin/sh
set -eu

CHECKS=/run/usb-wallet/boot-checks.txt
LOCKDOWN=/run/usb-wallet/lockdown
BOOT_DEVICE_FILE=/run/usb-wallet/boot-device
BOOT_PARENT_FILE=/run/usb-wallet/boot-parent
VAULT_DEVICE_FILE=/run/usb-wallet/vault-device
TRANSFER_DEVICE_FILE=/run/usb-wallet/transfer-device
BOOT_SYSFS_FILE=/run/usb-wallet/boot-sysfs-path
BOOT_DISKSEQ_FILE=/run/usb-wallet/boot-diskseq
FAILED=0

mkdir -p /run/usb-wallet /mnt/cold-vault /mnt/transfer
chmod 0700 /run/usb-wallet /mnt/cold-vault /mnt/transfer
: > "$CHECKS"
rm -f "$LOCKDOWN" "$BOOT_DEVICE_FILE" "$BOOT_PARENT_FILE" "$VAULT_DEVICE_FILE" "$TRANSFER_DEVICE_FILE" "$BOOT_SYSFS_FILE" "$BOOT_DISKSEQ_FILE"

pass() {
	printf 'PASS: %s\n' "$1" >> "$CHECKS"
}

fail() {
	printf 'FAIL: %s\n' "$1" >> "$CHECKS"
	FAILED=1
}

block_parent_name() {
	node="${1##*/}"
	resolved="$(readlink -f "/sys/class/block/$node" 2>/dev/null || true)"
	[ -n "$resolved" ] || return 1
	parent="$(basename "$(dirname "$resolved")")"
	[ -e "/sys/class/block/$parent" ] || return 1
	printf '%s\n' "$parent"
}

mount_source() {
	awk -v target="$1" '$2 == target { print $1; exit }' /proc/mounts 2>/dev/null || true
}

# This image intentionally has no swap. Be defensive if firmware or a future
# image accidentally exposes one.
swapoff -a 2>/dev/null || true

BOOT_DEVICE=""
VAULT_DEVICE=""
BOOT_PARENT=""
VAULT_PARENT=""

# BusyBox blkid only lists labels/UUIDs and rejects util-linux -t/-o/-s.
# The independent Python helper verifies primary GPT CRC, both partition
# GUIDs, FAT labels and uniqueness across USB disks before returning paths.
MEDIA_PARENT=""
TRANSFER_DEVICE=""
# This marker is public and lets the host test attach USB after init starts.
if [ -c /dev/ttyS0 ]; then
    printf 'USB_WALLET_MEDIA_WAIT\n' > /dev/ttyS0
fi
if MEDIA_IDENTITY="$(/usr/bin/python3 /usr/libexec/usb-wallet-identify-media 2>/dev/null)"; then
    # Helper emits boot, vault, optional same-device transfer ("-" if absent),
    # then a kernel block basename. None of these fields are shell-controlled.
    set -- $MEDIA_IDENTITY
    if [ "$#" -eq 8 ]; then
        BOOT_DEVICE="$1"
        VAULT_DEVICE="$2"
        [ "$3" = "-" ] || TRANSFER_DEVICE="$3"
        MEDIA_PARENT="$4"
        EXPECTED_SYSFS="$5"
        EXPECTED_DISKSEQ="$6"
        EXPECTED_VAULT_DEV="$7"
        pass "USB readiness: two complete stable scans within 60 seconds"
        if [ -n "$TRANSFER_DEVICE" ]; then
            pass "unique single-USB boot, vault and transfer layout verified by GPT CRC, GUID, size and FAT label"
        else
            pass "unique legacy boot and vault partitions verified by GPT CRC, GUID, size and FAT label"
        fi
    else
        fail "boot media identifier returned malformed output"
    fi
else
    status=$?
    case "$status" in
        3) fail "USB readiness: duplicate or conflicting media identity" ;;
        4) fail "USB readiness: enumeration or I/O deadline expired (60 seconds)" ;;
        5) fail "USB readiness: observed device identity replaced" ;;
        *) fail "USB readiness: permanent GPT/FAT/sysfs validation failure" ;;
    esac
fi

if [ -n "$BOOT_DEVICE" ] && [ -n "$VAULT_DEVICE" ]; then
	BOOT_PARENT="$(block_parent_name "$BOOT_DEVICE" 2>/dev/null || true)"
	VAULT_PARENT="$(block_parent_name "$VAULT_DEVICE" 2>/dev/null || true)"
	if [ -n "$BOOT_PARENT" ] && [ "$BOOT_PARENT" = "$VAULT_PARENT" ] && [ "$BOOT_PARENT" = "$MEDIA_PARENT" ]; then
		pass "boot and vault partitions share verified block parent ($BOOT_PARENT)"
		printf '%s\n' "$BOOT_DEVICE" > "$BOOT_DEVICE_FILE"
		printf '%s\n' "$BOOT_PARENT" > "$BOOT_PARENT_FILE"
		printf '%s\n' "$VAULT_DEVICE" > "$VAULT_DEVICE_FILE"
		BOOT_SYSFS="$(readlink -f "/sys/class/block/$BOOT_PARENT" 2>/dev/null || true)"
		BOOT_DISKSEQ="$(cat "/sys/class/block/$BOOT_PARENT/diskseq" 2>/dev/null || true)"
		if [ "$BOOT_SYSFS" = "$EXPECTED_SYSFS" ] && [ "$BOOT_DISKSEQ" = "$EXPECTED_DISKSEQ" ]; then
			printf '%s\n' "$BOOT_SYSFS" > "$BOOT_SYSFS_FILE"
			printf '%s\n' "$BOOT_DISKSEQ" > "$BOOT_DISKSEQ_FILE"
			pass "boot USB sysfs ancestry and disk sequence pinned for runtime replacement detection"
		else
			fail "boot USB sysfs ancestry or disk sequence unavailable"
		fi
		if [ -n "$TRANSFER_DEVICE" ]; then
			TRANSFER_PARENT="$(block_parent_name "$TRANSFER_DEVICE" 2>/dev/null || true)"
			if [ "$TRANSFER_PARENT" = "$BOOT_PARENT" ]; then
				printf '%s\n' "$TRANSFER_DEVICE" > "$TRANSFER_DEVICE_FILE"
				pass "single-USB TX_TRANSFER partition bound to verified boot parent ($BOOT_PARENT)"
			else
				fail "verified TX_TRANSFER partition is not on the boot/vault parent"
			fi
		fi
	else
		fail "boot and vault partitions are not on the same verified block device"
	fi
fi

# The ESP is needed only by firmware/GRUB. It must not remain mounted in the
# cold runtime. GPT bit 60 is verified from raw media separately; Linux does
# not treat that GPT attribute as a generic block-device write lock.
if [ "$FAILED" -eq 0 ] && [ -n "$BOOT_DEVICE" ]; then
	# Match the kernel major:minor identity, not a spelling of /dev/sdX1.
	# A read-only mount via /dev/disk/by-* must be rejected as well.
	BOOT_MAJMIN="$(cat "/sys/class/block/${BOOT_DEVICE##*/}/dev" 2>/dev/null || true)"
	if [ -z "$BOOT_MAJMIN" ] || [ ! -r /proc/self/mountinfo ]; then
		fail "boot partition mount identity or mountinfo unavailable"
	elif awk -v dev="$BOOT_MAJMIN" '$3 == dev { found=1 } END { exit found ? 0 : 1 }' /proc/self/mountinfo 2>/dev/null; then
		fail "boot partition is mounted in cold runtime"
	else
		pass "boot partition is not mounted in cold runtime"
	fi
fi

# Repeat the full identity/uniqueness check at the mount boundary. The
# initial mount is read-only so a replacement cannot receive FAT writes.
media_unchanged() {
    /usr/bin/python3 /usr/libexec/usb-wallet-identify-media --check "$MEDIA_IDENTITY" >/dev/null 2>&1
}

vault_mount_matches() {
    awk -v dev="$EXPECTED_VAULT_DEV" '
        $5 == "/mnt/cold-vault" { count++; if ($3 == dev) matchdev++ }
        END { exit !(count == 1 && matchdev == 1) }
    ' /proc/self/mountinfo
}

# Mount only the exact, unique vault partition identified above. A duplicated
# PARTUUID (for example, two cloned boot USBs attached at once) fails closed.
if [ "$FAILED" -eq 0 ] && [ -n "$VAULT_DEVICE" ]; then
    current="$(mount_source /mnt/cold-vault)"
    if [ -n "$current" ] || ! media_unchanged; then
        fail "COLD_VAULT pre-mount identity verification failed"
    elif ! mount -t vfat -o ro,noexec,nodev,nosuid,sync,fmask=0177,dmask=0077 \
        "$VAULT_DEVICE" /mnt/cold-vault 2>/dev/null; then
        fail "COLD_VAULT read-only mount failed"
    elif ! vault_mount_matches || ! media_unchanged; then
        fail "COLD_VAULT identity changed during read-only mount"
    elif ! mount -t vfat -o remount,rw,noexec,nodev,nosuid,sync,fmask=0177,dmask=0077 \
        "$VAULT_DEVICE" /mnt/cold-vault 2>/dev/null; then
        fail "COLD_VAULT restrictive remount failed"
    elif ! vault_mount_matches || ! media_unchanged; then
        fail "COLD_VAULT identity changed during remount"
    elif [ "$(mount_source /mnt/cold-vault)" = "$VAULT_DEVICE" ]; then
        pass "COLD_VAULT mount source matches verified PARTUUID device"
    else
        fail "COLD_VAULT mount source does not match verified PARTUUID device"
    fi
fi

if [ -d /proc/net ]; then
	fail "/proc/net exists; kernel networking is present"
else
	pass "/proc/net absent (CONFIG_NET expected disabled)"
fi

if [ -s /proc/swaps ] && [ "$(wc -l < /proc/swaps)" -gt 1 ]; then
	fail "active swap detected"
else
	pass "no active swap"
fi

ROOT_TYPE="$(awk '$2 == "/" { print $3; exit }' /proc/mounts 2>/dev/null || true)"
case "$ROOT_TYPE" in
	rootfs|tmpfs)
		pass "root filesystem is RAM-backed ($ROOT_TYPE)"
		;;
	*)
		fail "root filesystem is not recognized as RAM-backed (type=${ROOT_TYPE:-missing})"
		;;
esac

VAULT_SOURCE="$(mount_source /mnt/cold-vault)"
VAULT_TYPE="$(awk '$2 == "/mnt/cold-vault" { print $3; exit }' /proc/mounts 2>/dev/null || true)"
VAULT_OPTS="$(awk '$2 == "/mnt/cold-vault" { print $4; exit }' /proc/mounts 2>/dev/null || true)"
if [ "$VAULT_TYPE" = "vfat" ] && [ -n "$VAULT_DEVICE" ] && [ "$VAULT_SOURCE" = "$VAULT_DEVICE" ]; then
	pass "COLD_VAULT mounted from verified PARTUUID device as vfat"
	VAULT_FLAGS_OK=1
	for option in rw noexec nodev nosuid sync fmask=0177 dmask=0077; do
		case ",$VAULT_OPTS," in
			*",$option,"*) ;;
			*) fail "COLD_VAULT missing mount option: $option"; VAULT_FLAGS_OK=0 ;;
		esac
	done
	if [ "$VAULT_FLAGS_OK" -eq 1 ]; then
		pass "COLD_VAULT restrictive mount options verified"
	fi
else
	fail "COLD_VAULT source/type does not match verified PARTUUID device"
fi

# Read-only mounts can still expose internal disks or the ESP to the
# appliance. Permit only the verified vault and the minimal pseudo-filesystems.
UNEXPECTED_PERSISTENT="$(
	awk '
	$2 != "/mnt/cold-vault" &&
	$3 !~ /^(rootfs|tmpfs|proc|sysfs|devtmpfs|devpts|cgroup2|pstore|tracefs)$/ {
		print $2 " (" $1 ", " $3 ")"
	}' /proc/mounts 2>/dev/null || true
)"
if [ -n "$UNEXPECTED_PERSISTENT" ]; then
	fail "unexpected persistent mount(s): $UNEXPECTED_PERSISTENT"
else
	pass "no unexpected writable persistent filesystem mounted"
fi

if [ "$FAILED" -ne 0 ]; then
    # A failed mount audit must not leave writable vault media accessible.
    if [ -n "$(mount_source /mnt/cold-vault)" ]; then
        umount /mnt/cold-vault 2>/dev/null || fail "COLD_VAULT cleanup failed"
    fi
	rm -f "$BOOT_DEVICE_FILE" "$BOOT_PARENT_FILE" "$VAULT_DEVICE_FILE" "$TRANSFER_DEVICE_FILE" "$BOOT_SYSFS_FILE" "$BOOT_DISKSEQ_FILE"
	: > "$LOCKDOWN"
	printf 'LOCKDOWN: one or more boot security checks failed\n' >> "$CHECKS"
else
	pass "offline startup audit complete"
fi

# Report only the final audit result on the emulated UART. No wallet secrets or
# addresses are written to this diagnostic channel.
if [ -c /dev/ttyS0 ]; then
	if [ "$FAILED" -eq 0 ]; then
		# Emit bounded, public audit evidence before the final marker so CI
		# validates the guest checks themselves, not a marker in isolation.
		grep '^PASS:' "$CHECKS" > /dev/ttyS0 || true
		printf 'USB_WALLET_UEFI_AUDIT_OK\n' > /dev/ttyS0
	else
		# Failure reasons contain only public mount/configuration facts.
		# Include them in the emulated serial log to diagnose a locked boot.
		grep '^FAIL:' "$CHECKS" > /dev/ttyS0 || true
		printf 'USB_WALLET_UEFI_AUDIT_LOCKDOWN\n' > /dev/ttyS0
	fi
fi
