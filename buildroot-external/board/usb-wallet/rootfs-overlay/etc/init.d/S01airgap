#!/bin/sh
set -eu

CHECKS=/run/usb-wallet/boot-checks.txt
LOCKDOWN=/run/usb-wallet/lockdown
FAILED=0

mkdir -p /run/usb-wallet /mnt/cold-vault /mnt/transfer
chmod 0700 /mnt/cold-vault /mnt/transfer
: > "$CHECKS"
rm -f "$LOCKDOWN"

pass() {
	printf 'PASS: %s\n' "$1" >> "$CHECKS"
}

fail() {
	printf 'FAIL: %s\n' "$1" >> "$CHECKS"
	FAILED=1
}

# This image intentionally has no swap. Be defensive if firmware or a future
# image accidentally exposes one.
swapoff -a 2>/dev/null || true

# The boot USB's second partition is the only place the encrypted vault may
# persist. It is never the transaction transport medium.
if ! grep -q ' /mnt/cold-vault ' /proc/mounts 2>/dev/null; then
	mount -t vfat -o rw,noexec,nodev,nosuid,sync,fmask=0177,dmask=0077 		-L COLD_VAULT /mnt/cold-vault 2>/dev/null || true
fi

if [ -d /proc/net ]; then
	fail "/proc/net exists; kernel networking is present"
else
	pass "/proc/net absent (CONFIG_NET expected disabled)"
fi

if [ -s /proc/swaps ] && [ "$(wc -l < /proc/swaps)" -gt 1 ]; then
	fail "active swap detected"
else
	pass "no active swap"
fi

ROOT_TYPE="$(awk '$2 == "/" { print $3; exit }' /proc/mounts 2>/dev/null || true)"
case "$ROOT_TYPE" in
	rootfs|tmpfs)
		pass "root filesystem is RAM-backed ($ROOT_TYPE)"
		;;
	*)
		fail "root filesystem is not recognized as RAM-backed (type=${ROOT_TYPE:-missing})"
		;;
esac

VAULT_TYPE="$(awk '$2 == "/mnt/cold-vault" { print $3; exit }' /proc/mounts 2>/dev/null || true)"
VAULT_OPTS="$(awk '$2 == "/mnt/cold-vault" { print $4; exit }' /proc/mounts 2>/dev/null || true)"
if [ "$VAULT_TYPE" = "vfat" ]; then
	pass "COLD_VAULT mounted as vfat"
	for option in rw noexec nodev nosuid sync; do
		case ",$VAULT_OPTS," in
			*",$option,"*) ;;
			*) fail "COLD_VAULT missing mount option: $option" ;;
		esac
	done
else
	fail "COLD_VAULT not mounted as vfat"
fi

UNEXPECTED_RW="$(
	awk '
	function hasopt(options, needle, n, parts, i) {
		n = split(options, parts, ",")
		for (i = 1; i <= n; i++) if (parts[i] == needle) return 1
		return 0
	}
	hasopt($4, "rw") &&
	$2 != "/mnt/cold-vault" &&
	$3 !~ /^(rootfs|tmpfs|proc|sysfs|devtmpfs|devpts|cgroup2|pstore|tracefs)$/ {
		print $2 " (" $1 ", " $3 ")"
	}' /proc/mounts 2>/dev/null || true
)"
if [ -n "$UNEXPECTED_RW" ]; then
	fail "unexpected writable non-memory mount(s): $UNEXPECTED_RW"
else
	pass "no unexpected writable persistent filesystem mounted"
fi

if [ "$FAILED" -ne 0 ]; then
	: > "$LOCKDOWN"
	printf 'LOCKDOWN: one or more boot security checks failed\n' >> "$CHECKS"
else
	pass "offline startup audit complete"
fi

# Report only the final audit result on the emulated UART. No wallet secrets or
# addresses are written to this diagnostic channel.
if [ -c /dev/ttyS0 ]; then
	if [ "$FAILED" -eq 0 ]; then
		printf 'USB_WALLET_UEFI_AUDIT_OK\n' > /dev/ttyS0
	else
		printf 'USB_WALLET_UEFI_AUDIT_LOCKDOWN\n' > /dev/ttyS0
	fi
fi
