#!/bin/sh
set -eu

CHECKS=/run/usb-wallet/boot-checks.txt
LOCKDOWN=/run/usb-wallet/lockdown
BOOT_DEVICE_FILE=/run/usb-wallet/boot-device
BOOT_PARENT_FILE=/run/usb-wallet/boot-parent
VAULT_DEVICE_FILE=/run/usb-wallet/vault-device
BOOT_PARTUUID=e2bd6d1b-8de5-502d-a897-c53a8e60f46b
VAULT_PARTUUID=18f1c36f-d5c0-5052-9cd2-03e9c2a48f00
FAILED=0

mkdir -p /run/usb-wallet /mnt/cold-vault /mnt/transfer
chmod 0700 /run/usb-wallet /mnt/cold-vault /mnt/transfer
: > "$CHECKS"
rm -f "$LOCKDOWN" "$BOOT_DEVICE_FILE" "$BOOT_PARENT_FILE" "$VAULT_DEVICE_FILE"

pass() {
	printf 'PASS: %s\n' "$1" >> "$CHECKS"
}

fail() {
	printf 'FAIL: %s\n' "$1" >> "$CHECKS"
	FAILED=1
}

unique_partuuid_device() {
	partuuid="$1"
	# Word splitting is intentional: block-device paths cannot contain spaces.
	set -- $(blkid -t "PARTUUID=$partuuid" -o device 2>/dev/null || true)
	[ "$#" -eq 1 ] || return 1
	printf '%s\n' "$1"
}

block_parent_name() {
	node="${1##*/}"
	resolved="$(readlink -f "/sys/class/block/$node" 2>/dev/null || true)"
	[ -n "$resolved" ] || return 1
	parent="$(basename "$(dirname "$resolved")")"
	[ -e "/sys/class/block/$parent" ] || return 1
	printf '%s\n' "$parent"
}

mount_source() {
	awk -v target="$1" '$2 == target { print $1; exit }' /proc/mounts 2>/dev/null || true
}

# This image intentionally has no swap. Be defensive if firmware or a future
# image accidentally exposes one.
swapoff -a 2>/dev/null || true

BOOT_DEVICE=""
VAULT_DEVICE=""
BOOT_PARENT=""
VAULT_PARENT=""

if BOOT_DEVICE="$(unique_partuuid_device "$BOOT_PARTUUID")"; then
	if [ "$(blkid -s LABEL -o value "$BOOT_DEVICE" 2>/dev/null || true)" = "USBCOLD_EFI" ]; then
		pass "unique boot partition identified by PARTUUID ($BOOT_DEVICE)"
	else
		fail "boot PARTUUID resolved to a partition with unexpected label"
	fi
else
	fail "boot PARTUUID is missing or duplicated"
fi

if VAULT_DEVICE="$(unique_partuuid_device "$VAULT_PARTUUID")"; then
	if [ "$(blkid -s LABEL -o value "$VAULT_DEVICE" 2>/dev/null || true)" = "COLD_VAULT" ]; then
		pass "unique COLD_VAULT partition identified by PARTUUID ($VAULT_DEVICE)"
	else
		fail "vault PARTUUID resolved to a partition with unexpected label"
	fi
else
	fail "vault PARTUUID is missing or duplicated"
fi

if [ -n "$BOOT_DEVICE" ] && [ -n "$VAULT_DEVICE" ]; then
	BOOT_PARENT="$(block_parent_name "$BOOT_DEVICE" 2>/dev/null || true)"
	VAULT_PARENT="$(block_parent_name "$VAULT_DEVICE" 2>/dev/null || true)"
	if [ -n "$BOOT_PARENT" ] && [ "$BOOT_PARENT" = "$VAULT_PARENT" ]; then
		pass "boot and vault partitions share verified block parent ($BOOT_PARENT)"
		printf '%s\n' "$BOOT_DEVICE" > "$BOOT_DEVICE_FILE"
		printf '%s\n' "$BOOT_PARENT" > "$BOOT_PARENT_FILE"
		printf '%s\n' "$VAULT_DEVICE" > "$VAULT_DEVICE_FILE"
	else
		fail "boot and vault partitions are not on the same verified block device"
	fi
fi

# Mount only the exact, unique vault partition identified above. A duplicated
# PARTUUID (for example, two cloned boot USBs attached at once) fails closed.
if [ "$FAILED" -eq 0 ] && [ -n "$VAULT_DEVICE" ]; then
	current="$(mount_source /mnt/cold-vault)"
	if [ -z "$current" ]; then
		mount -t vfat -o rw,noexec,nodev,nosuid,sync,fmask=0177,dmask=0077 \
			"$VAULT_DEVICE" /mnt/cold-vault 2>/dev/null || true
		current="$(mount_source /mnt/cold-vault)"
	fi
	if [ "$current" = "$VAULT_DEVICE" ]; then
		pass "COLD_VAULT mount source matches verified PARTUUID device"
	else
		fail "COLD_VAULT mount source does not match verified PARTUUID device"
	fi
fi

if [ -d /proc/net ]; then
	fail "/proc/net exists; kernel networking is present"
else
	pass "/proc/net absent (CONFIG_NET expected disabled)"
fi

if [ -s /proc/swaps ] && [ "$(wc -l < /proc/swaps)" -gt 1 ]; then
	fail "active swap detected"
else
	pass "no active swap"
fi

ROOT_TYPE="$(awk '$2 == "/" { print $3; exit }' /proc/mounts 2>/dev/null || true)"
case "$ROOT_TYPE" in
	rootfs|tmpfs)
		pass "root filesystem is RAM-backed ($ROOT_TYPE)"
		;;
	*)
		fail "root filesystem is not recognized as RAM-backed (type=${ROOT_TYPE:-missing})"
		;;
esac

VAULT_SOURCE="$(mount_source /mnt/cold-vault)"
VAULT_TYPE="$(awk '$2 == "/mnt/cold-vault" { print $3; exit }' /proc/mounts 2>/dev/null || true)"
VAULT_OPTS="$(awk '$2 == "/mnt/cold-vault" { print $4; exit }' /proc/mounts 2>/dev/null || true)"
if [ "$VAULT_TYPE" = "vfat" ] && [ -n "$VAULT_DEVICE" ] && [ "$VAULT_SOURCE" = "$VAULT_DEVICE" ]; then
	pass "COLD_VAULT mounted from verified PARTUUID device as vfat"
	for option in rw noexec nodev nosuid sync; do
		case ",$VAULT_OPTS," in
			*",$option,"*) ;;
			*) fail "COLD_VAULT missing mount option: $option" ;;
		esac
	done
else
	fail "COLD_VAULT source/type does not match verified PARTUUID device"
fi

UNEXPECTED_RW="$(
	awk '
	function hasopt(options, needle, n, parts, i) {
		n = split(options, parts, ",")
		for (i = 1; i <= n; i++) if (parts[i] == needle) return 1
		return 0
	}
	hasopt($4, "rw") &&
	$2 != "/mnt/cold-vault" &&
	$3 !~ /^(rootfs|tmpfs|proc|sysfs|devtmpfs|devpts|cgroup2|pstore|tracefs)$/ {
		print $2 " (" $1 ", " $3 ")"
	}' /proc/mounts 2>/dev/null || true
)"
if [ -n "$UNEXPECTED_RW" ]; then
	fail "unexpected writable non-memory mount(s): $UNEXPECTED_RW"
else
	pass "no unexpected writable persistent filesystem mounted"
fi

if [ "$FAILED" -ne 0 ]; then
	rm -f "$BOOT_DEVICE_FILE" "$BOOT_PARENT_FILE" "$VAULT_DEVICE_FILE"
	: > "$LOCKDOWN"
	printf 'LOCKDOWN: one or more boot security checks failed\n' >> "$CHECKS"
else
	pass "offline startup audit complete"
fi

# Report only the final audit result on the emulated UART. No wallet secrets or
# addresses are written to this diagnostic channel.
if [ -c /dev/ttyS0 ]; then
	if [ "$FAILED" -eq 0 ]; then
		printf 'USB_WALLET_UEFI_AUDIT_OK\n' > /dev/ttyS0
	else
		printf 'USB_WALLET_UEFI_AUDIT_LOCKDOWN\n' > /dev/ttyS0
	fi
fi
